{
  "name": "rexosiris",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.6", "bun": ">=1.3" },
  "scripts": {
    "build": "bun build src/client/main.ts --outfile public/app.js --minify --target browser",
    "dev": "bun run build && bun src/server/dev.ts",
    "audio": "bun scripts/transcode.ts",
    "charts:generate": "bun scripts/charts/generate.ts",
    "charts:assemble": "bun scripts/charts/assemble.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "bun --bun oxlint --type-aware --deny-warnings src scripts lint netlify",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": { "@netlify/blobs": "^8.1.0" },
  "devDependencies": {
    "bun-types": "^1.3.0",
    "netlify-cli": "27.16.1",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "typescript": "^5.6.0"
  }
}
